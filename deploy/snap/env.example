# Copy this to $SNAP_DATA/env after installing the panem snap (usually
# /var/snap/panem/current/env) and fill in the secrets. Every daemon
# wrapper (snap/local/bin/panem-*) sources it before starting, so anything
# set here overrides that wrapper's own defaults (DATA_DIR, API_HOST,
# STATIC_UPLOADS_DIR, LEMONADE_HOME) too, if you ever need to.
#
#   sudo mkdir -p /var/snap/panem/current
#   sudo cp deploy/snap/env.example /var/snap/panem/current/env
#   sudo chmod 600 /var/snap/panem/current/env
#   sudo $EDITOR /var/snap/panem/current/env
#   sudo snap restart panem
#
# Every field below matches packages/panem_shared/src/panem_shared/settings.py
# (Settings) / .env.example -- that file has the full commentary on what
# each one does. Only the ones an operator actually has to touch to get a
# same-LXD-container deployment running are repeated here.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Postgres/Redis running in the same LXD container as this snap
# (deploy/lxd/provision.sh's defaults) are already reachable at these
# addresses -- only change them if you pointed the snap at a database
# outside this container.
DATABASE_URL=postgresql+asyncpg://panem:panem@localhost:5432/panem
REDIS_URL=redis://localhost:6379/0

STAFF_ROLE_ID=
APPROVAL_CHANNEL_ID=
LOG_CHANNEL_ID=

# Set this to the URL Discord clients can actually reach this container's
# panem.api on (a reverse proxy in front of it, or a tunnel) to enable
# /work's minigame. Leave blank to keep the classic option-select /work.
ACTIVITY_PUBLIC_URL=

# NPC dialogue defaults to canned template lines (no LLM at all) unless
# this is set to "llm". The panem.lemonade daemon (snap/snapcraft.yaml)
# runs Embeddable Lemonade in this same container/snap, already reachable
# at the LLM_BASE_URL below over loopback -- same assumption as
# DATABASE_URL/REDIS_URL above. After the snap's first install/refresh,
# run `sudo panem.lemonade-omni install` once to register the collection
# and download its model weights (several GB) before flipping this on.
# See deploy/snap/README.md and lemonade/README.md for the full walkthrough.
DIALOGUE_PROVIDER=template
LLM_BASE_URL=http://127.0.0.1:13305/v1
LLM_MODEL=panem-omni
LLM_API_KEY=
LEMONADE_PROFILE=lite
