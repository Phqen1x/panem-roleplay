DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed by panem_api's Activity OAuth token exchange -- the bot
# process doesn't read this.
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Set to false to skip the guild command-tree sync on startup (avoids
# Discord's command-sync rate limit when restarting frequently in dev).
# Flip back to true (or leave unset) whenever a command's signature changes.
DISCORD_SYNC_COMMANDS=true
DATABASE_URL=postgresql+asyncpg://panem:panem@localhost:5432/panem
REDIS_URL=redis://localhost:6379/0
TICK_INTERVAL_SECONDS=600
# panem_api (Phase 5, the Activity's live-map bridge). No auth is
# enforced yet -- see the README's Milestone H notes.
API_HOST=0.0.0.0
API_PORT=8000
# Externally reachable base URL for panem_api (not API_HOST/API_PORT,
# which are only a bind address) -- lets /work link to its minigame.
# Leave unset to keep /work's classic option-select flow.
ACTIVITY_PUBLIC_URL=
DIALOGUE_PROVIDER=template
LLM_BASE_URL=http://127.0.0.1:13305/v1
LLM_MODEL=panem-omni
LLM_API_KEY=
LLM_TIMEOUT_MS=8000
LEMONADE_PROFILE=lite
LEMONADE_HOME=
LEMONADE_EMBEDDABLE_VERSION=11.9.0
LLM_MAX_CONCURRENT=4
LLM_MIN_IMPORTANCE=2
STAFF_ROLE_ID=
APPROVAL_CHANNEL_ID=
LOG_CHANNEL_ID=

# Optional: use a pre-existing role for a district's forum permissions
# instead of letting scripts/setup_guild.py create/find one by name.
# Leave blank to auto-manage by name (default).
CAPITOL_ROLE_ID=
DISTRICT_1_ROLE_ID=
DISTRICT_2_ROLE_ID=
DISTRICT_3_ROLE_ID=
DISTRICT_4_ROLE_ID=
DISTRICT_5_ROLE_ID=
DISTRICT_6_ROLE_ID=
DISTRICT_7_ROLE_ID=
DISTRICT_8_ROLE_ID=
DISTRICT_9_ROLE_ID=
DISTRICT_10_ROLE_ID=
DISTRICT_11_ROLE_ID=
DISTRICT_12_ROLE_ID=
SCENE_AUTO_ARCHIVE_MINUTES=1440
MAX_ACTIVE_SCENES_PER_DISTRICT=60
# Default active (pending+approved) characters per user; staff can override
# a specific user's limit with /staff character_limit.
MAX_CHARACTERS_PER_USER=1
WORLD_SEED=panem-long-year
