DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed by panem_api's Activity OAuth token exchange -- the bot
# process doesn't read this.
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Set to false to skip the guild command-tree sync on startup (avoids
# Discord's command-sync rate limit when restarting frequently in dev).
# Flip back to true (or leave unset) whenever a command's signature changes.
DISCORD_SYNC_COMMANDS=true
DATABASE_URL=postgresql+asyncpg://panem:panem@localhost:5432/panem
REDIS_URL=redis://localhost:6379/0
TICK_INTERVAL_SECONDS=600
# panem_api (Phase 5, the Activity's live-map bridge). No auth is
# enforced yet -- see the README's Milestone H notes.
API_HOST=0.0.0.0
API_PORT=8000
# Externally reachable base URL for panem_api (not API_HOST/API_PORT,
# which are only a bind address) -- lets /work link to its minigame, and
# lets the dashboard's character-avatar file upload build a permanent URL
# for the image it saves. Leave unset to keep /work's classic
# option-select flow and disable avatar uploads (a plain avatar URL still
# works either way).
ACTIVITY_PUBLIC_URL=
# Server-to-server base URL panem_bot uses to reach panem_api (persisting
# an uploaded /character avatar attachment). Leave unset to assume both
# processes run on the same host (http://localhost:$API_PORT); docker
# compose sets this to http://api:8000 itself.
API_INTERNAL_URL=
DIALOGUE_PROVIDER=template
LLM_BASE_URL=http://127.0.0.1:13305/v1
LLM_MODEL=panem-omni
LLM_API_KEY=
LLM_TIMEOUT_MS=10000
LEMONADE_PROFILE=lite
LEMONADE_HOME=
LEMONADE_EMBEDDABLE_VERSION=11.9.0
LLM_MAX_CONCURRENT=4
LLM_MIN_IMPORTANCE=2
# Semantic NPC memory recall (embedding model of the active profile). Only used
# when a conversation goes through the LLM; any failure falls back to the old
# importance/recency pick. Blank EMBEDDING_MODEL = the profile's own embedder.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=15000
# Speech-to-text: a Discord voice message in a scene is transcribed by Whisper
# and proxied as the character's words. Blank STT_MODEL = the profile's Whisper.
STT_ENABLED=true
STT_MODEL=
STT_TIMEOUT_MS=60000
STT_MAX_AUDIO_SECONDS=120
# Text-to-speech (Kokoro, a separate download: `lemonade_omni.py install --with-tts`).
# Off by default; when on, NPCs only speak in scenes that ran `/engage voice`.
TTS_ENABLED=false
TTS_MODEL=kokoro-v1
TTS_TIMEOUT_MS=30000
TTS_FORMAT=mp3
TTS_MAX_CHARS=500
STAFF_ROLE_ID=
APPROVAL_CHANNEL_ID=
LOG_CHANNEL_ID=

# Comma-separated Discord role ids (e.g. "111111111111111111,222222222222222222")
# allowed to customize the Activity dashboard's background/accent colors
# (a donor perk). Leave blank to disable the feature entirely -- no one
# sees the color-wheel button.
DONOR_ROLE_IDS=

# Optional: use a pre-existing role for a district's forum permissions
# instead of letting scripts/setup_guild.py create/find one by name.
# Leave blank to auto-manage by name (default).
CAPITOL_ROLE_ID=
DISTRICT_1_ROLE_ID=
DISTRICT_2_ROLE_ID=
DISTRICT_3_ROLE_ID=
DISTRICT_4_ROLE_ID=
DISTRICT_5_ROLE_ID=
DISTRICT_6_ROLE_ID=
DISTRICT_7_ROLE_ID=
DISTRICT_8_ROLE_ID=
DISTRICT_9_ROLE_ID=
DISTRICT_10_ROLE_ID=
DISTRICT_11_ROLE_ID=
DISTRICT_12_ROLE_ID=
SCENE_AUTO_ARCHIVE_MINUTES=1440
MAX_ACTIVE_SCENES_PER_DISTRICT=60
# Default active (pending+approved) characters per user; staff can override
# a specific user's limit with /staff character_limit.
MAX_CHARACTERS_PER_USER=1
WORLD_SEED=panem-long-year

# Only needed for a packaged, non-editable install (the snap -- see
# deploy/snap/README.md) whose panem_* modules no longer live next to a
# checked-out data/ dir. Leave blank everywhere else (uv run, Docker):
# each process finds data/ by walking up from its own source location.
DATA_DIR=
# Same idea, for panem_api's writable uploads (staff layer images,
# district_mottos.json) -- a strict-confinement snap's $SNAP is read-only,
# so this points it at $SNAP_DATA/uploads instead. Leave blank to keep
# writing into the bundled static/ tree, as every non-snap deployment does.
STATIC_UPLOADS_DIR=
